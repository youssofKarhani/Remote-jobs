# ==============================================================================
# RemoteJobs Public Platform - Backend Environment Configuration
# ==============================================================================

# Application Runtime
APP_NAME="RemoteJobs Public Platform API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Database Settings
# Default: SQLite dev file; Production: PostgreSQL
DATABASE_URL="sqlite:///./remotejobs_dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/remotejobs_db"

# Security & Authentication
SECRET_KEY="dev-secret-key-change-in-production-0987654321"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==============================================================================
# AI Gateway Configuration (LiteLLM / AWS Inference Infrastructure / Ollama)
# ==============================================================================

# Provider Mode: "litellm", "openai", "ollama", "mock"
LLM_PROVIDER="litellm"

# AI Inference Gateway URL:
# Local LiteLLM Compose:   http://localhost:4000/v1
# AWS Control Plane EC2:   http://51.20.134.201:4000/v1
# Local Ollama:            http://localhost:11434/v1
LLM_BASE_URL="http://localhost:4000/v1"

# API Key (Matches LiteLLM master_key in litellm/config.yaml)
LLM_API_KEY="sk-dev-litellm-key"

# Logical Model Routing (Mapped by LiteLLM to underlying LLMs / vLLM backends)
LLM_MODEL_PRESCREEN="fast"
LLM_MODEL_ASSESSMENT="reasoning"
LLM_MODEL_EXTRACTION="fast"
LLM_MODEL_TAILORING="reasoning"
LLM_MODEL_COVER_LETTER="fast"

# Resiliency, Timeouts & Fallbacks
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2
LLM_FALLBACK_TO_HEURISTICS=true

# Orchestrator Service (for async heavy jobs)
ORCHESTRATOR_URL="http://localhost:8000"

# Optional AWS Direct Control Plane Endpoint
# AWS_INFERENCE_ENDPOINT="http://51.20.134.201:4000/v1"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

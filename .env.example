# ==============================================================================
# RemoteJobs Public Platform - Environment Configuration Template
# Copy this file to .env and customize values for local development or production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=remotejobs
POSTGRES_USER=remotejobs
POSTGRES_PASSWORD=remotejobs_secure_password
POSTGRES_PORT=5432
# Full connection string used by FastAPI backend:
DATABASE_URL=postgresql://remotejobs:remotejobs_secure_password@localhost:5432/remotejobs
# (Or sqlite fallback for quick testing without Docker):
# DATABASE_URL=sqlite:///./remotejobs_dev.db

# ------------------------------------------------------------------------------
# 2. Redis Cache & Job Broker
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
SECRET_KEY=change-in-production-long-random-entropy-string-0987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# 4. CORS Origins (Comma-separated or JSON list)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. AI Service Gateway / LLM Settings (Ollama / OpenAI / Claude compatible)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_PRESCREEN=llama3
LLM_MODEL_ASSESSMENT=llama3
LLM_MODEL_EXTRACTION=llama3

# ------------------------------------------------------------------------------
# 6. Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
